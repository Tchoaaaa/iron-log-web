# Copy this file to `.env` and fill in your Supabase project values.
#
#   cp .env.example .env
#
# Both values below are CLIENT-SIDE and safe to ship in the browser bundle:
#   - the project URL is public
#   - the "publishable" key (sb_publishable_...) only works together with
#     Row Level Security, which this project enables on every table.
#
# NEVER add the "secret" / "service_role" key here or anywhere in this repo.
# The app does not need it and must never use it.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
